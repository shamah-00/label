    function init() {
        const state = document.getElementById("shipping_state");
        const city = document.getElementById("shipping_city");
        const list = document.getElementById("us-city-suggestions");
        if (!state || !city || !list) return;

        function updateCities() {
            const previous = city.value;
            list.replaceChildren();
            (citiesByState[state.value] || []).forEach(function (name) {
                list.appendChild(new Option(name, name));
            });
            city.placeholder = state.value ? "Enter or choose your city" : "Choose a state first";
            if (previous) city.value = previous;
        }

        state.addEventListener("change", updateCities);
        updateCities();
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
    } else {
        init();
    }
})();
</script>
