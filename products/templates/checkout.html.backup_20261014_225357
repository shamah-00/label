{% block title %}Checkout | THE LABEL GROUP{% endblock %}

<style id="tlg-professional-checkout">
:root {
    --tlg-navy: #0b1f3a;
    --tlg-navy-dark: #06152a;
    --tlg-orange: #f47b20;
    --tlg-orange-dark: #d9620d;
    --tlg-border: #e1e7ef;
    --tlg-muted: #667085;
    --tlg-surface: #f6f8fb;
}
.tlg-checkout, .tlg-checkout * { box-sizing: border-box; }
.tlg-checkout {
    max-width: 1240px;
    margin: 0 auto;
    padding: 38px 22px 64px;
    color: #172337;
    font-family: inherit;
}
.tlg-checkout h1, .tlg-checkout h2, .tlg-checkout h3 {
    color: var(--tlg-navy);
    letter-spacing: -.025em;
}
.tlg-checkout-header {
    margin-bottom: 30px;
    padding: 28px 32px;
    border-radius: 18px;
    background: linear-gradient(120deg, var(--tlg-navy-dark), var(--tlg-navy) 68%, #17416a);
    color: #fff;
}
.tlg-checkout-eyebrow {
    margin: 0 0 8px;
    color: #ffb36d;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
}
.tlg-checkout-header h1 {
    margin: 0;
    color: #fff;
    font-size: clamp(29px, 4vw, 39px);
    line-height: 1.15;
}
.tlg-checkout-header p {
    margin: 10px 0 0;
    color: #e1eaf5;
    line-height: 1.6;
}
.tlg-checkout-secure {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 17px;
    color: #fff;
    font-size: 13px;
}
.tlg-checkout-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 350px;
    gap: 26px;
    align-items: start;
}
.tlg-checkout-main { min-width: 0; }
.tlg-panel {
    min-width: 0;
    margin-bottom: 22px;
    padding: 27px;
    border: 1px solid var(--tlg-border);
    border-radius: 15px;
    background: #fff;
    box-shadow: 0 5px 20px rgba(11,31,58,.045);
}
.tlg-panel-heading {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    margin-bottom: 23px;
}
.tlg-step {
    display: inline-flex;
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: #fff2e7;
    color: var(--tlg-orange-dark);
    font-size: 14px;
    font-weight: 800;
}
.tlg-panel-heading h2 {
    margin: 1px 0 5px;
    font-size: 20px;
}
.tlg-panel-heading p {
    margin: 0;
    color: var(--tlg-muted);
    font-size: 13px;
    line-height: 1.5;
}
.tlg-form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 17px 18px;
}
.tlg-field { min-width: 0; }
.tlg-field-full { grid-column: 1 / -1; }
.tlg-checkout label {
    display: block;
    margin-bottom: 7px;
    color: var(--tlg-navy);
    font-size: 13px;
    font-weight: 700;
}
.tlg-required { color: var(--tlg-orange-dark); }
.tlg-checkout input:not([type="radio"]):not([type="checkbox"]):not([type="hidden"]),
.tlg-checkout select,
.tlg-checkout textarea {
    display: block;
    width: 100%;
    max-width: 100%;
    min-height: 45px;
    margin: 0;
    padding: 11px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: #fff;
    color: #172337;
    font: inherit;
    font-size: 14px;
    transition: border-color .15s, box-shadow .15s;
}
.tlg-checkout textarea { min-height: 90px; resize: vertical; }
.tlg-checkout input:focus,
.tlg-checkout select:focus,
.tlg-checkout textarea:focus {
    outline: none;
    border-color: var(--tlg-orange);
    box-shadow: 0 0 0 3px rgba(244,123,32,.13);
}
.tlg-checkout input[readonly] { background: #f3f5f8; color: #475467; }
.tlg-field-hint {
    margin: 6px 0 0;
    color: var(--tlg-muted);
    font-size: 12px;
    line-height: 1.45;
}
.tlg-shipping-heading {
    padding: 22px 24px;
    border-radius: 12px 12px 0 0;
    background: linear-gradient(120deg, var(--tlg-navy-dark), var(--tlg-navy));
    color: white;
}
.tlg-shipping-heading .tlg-checkout-eyebrow { margin-bottom: 8px; }
.tlg-shipping-heading h2 {
    margin: 0 0 7px;
    color: white;
    font-size: 21px;
}
.tlg-shipping-heading p {
    margin: 0;
    color: #e1eaf5;
    font-size: 13px;
    line-height: 1.6;
}
.tlg-shipping-body { padding: 22px; }
.tlg-domestic-badge {
    display: inline-block;
    margin-top: 13px;
    padding: 6px 9px;
    border-radius: 6px;
    background: var(--tlg-orange);
    color: white;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .6px;
}
.tlg-origin {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 20px;
    padding: 15px;
    border: 1px solid #dce8f5;
    border-radius: 10px;
    background: #f3f7fc;
}
.tlg-origin-icon {
    display: flex;
    flex: 0 0 38px;
    height: 38px;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    background: white;
    font-size: 20px;
}
.tlg-origin strong { color: var(--tlg-navy); font-size: 13px; }
.tlg-origin p { margin: 5px 0 0; color: #53657a; font-size: 12px; line-height: 1.5; }
.tlg-rate-list { margin: 0 0 15px; padding: 0; border: 0; }
.tlg-rate-list legend {
    margin-bottom: 10px;
    color: var(--tlg-navy);
    font-size: 13px;
    font-weight: 800;
}
.tlg-rate {
    display: flex !important;
    align-items: center;
    gap: 12px;
    margin: 10px 0 !important;
    padding: 15px;
    border: 1px solid var(--tlg-border);
    border-radius: 10px;
    background: #fff;
    cursor: pointer;
    transition: border-color .15s, background .15s, box-shadow .15s;
}
.tlg-rate:hover { border-color: #f4b17f; }
.tlg-rate:has(input:checked) {
    border: 2px solid var(--tlg-orange);
    padding: 14px;
    background: #fff8f1;
    box-shadow: 0 0 0 3px rgba(244,123,32,.08);
}
.tlg-rate input[type="radio"] {
    flex: 0 0 18px;
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--tlg-orange);
}
.tlg-rate-info { flex: 1; min-width: 0; }
.tlg-rate-info strong {
    display: block;
    color: var(--tlg-navy);
    font-size: 13px;
    line-height: 1.45;
}
.tlg-rate-info small {
    display: block;
    margin-top: 4px;
    color: var(--tlg-muted);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.4;
}
.tlg-rate-price {
    color: var(--tlg-navy);
    font-size: 15px;
    font-weight: 800;
    white-space: nowrap;
}
.tlg-instructions, .tlg-error {
    margin-bottom: 16px;
    padding: 15px;
    border-radius: 9px;
    font-size: 13px;
    line-height: 1.6;
}
.tlg-instructions { background: #fff6ed; color: #344054; }
.tlg-instructions strong { color: #a94705; }
.tlg-instructions p { margin: 6px 0 0; }
.tlg-error {
    border: 1px solid #fda29b;
    background: #fff1f0;
    color: #7a271a;
    overflow-wrap: anywhere;
}
.tlg-error p { margin: 6px 0 0; }
.tlg-help { margin: 12px 0; color: var(--tlg-muted); font-size: 12px; line-height: 1.5; }
.tlg-button {
    display: inline-flex;
    min-height: 47px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 18px;
    border: 0;
    border-radius: 9px;
    font: inherit;
    font-size: 14px;
    font-weight: 800;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: background .15s, transform .15s;
}
.tlg-button:hover { transform: translateY(-1px); }
.tlg-button-calculate {
    width: 100%;
    background: var(--tlg-navy);
    color: white;
}
.tlg-button-calculate:hover { background: #17416a; }
.tlg-order-action {
    margin-top: 18px;
    padding: 17px;
    border: 1px solid #f4d0b2;
    border-radius: 12px;
    background: #fffaf5;
}
.tlg-order-action p {
    margin: 0 0 12px;
    color: #526174;
    font-size: 12px;
    line-height: 1.55;
}
.tlg-button-place {
    width: 100%;
    background: var(--tlg-orange);
    color: #fff;
    box-shadow: 0 4px 12px rgba(244,123,32,.18);
}
.tlg-button-place:hover { background: var(--tlg-orange-dark); }
.tlg-summary {
    position: sticky;
    top: 22px;
    overflow: hidden;
    border: 1px solid var(--tlg-border);
    border-radius: 15px;
    background: #fff;
    box-shadow: 0 7px 25px rgba(11,31,58,.07);
}
.tlg-summary-head {
    padding: 23px 23px 19px;
    border-bottom: 1px solid var(--tlg-border);
    background: #f8fafc;
}
.tlg-summary-head h2 { margin: 0 0 5px; font-size: 20px; }
.tlg-summary-head p { margin: 0; color: var(--tlg-muted); font-size: 12px; }
.tlg-summary-body { padding: 7px 23px 23px; }
.tlg-summary-item {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding: 16px 0;
    border-bottom: 1px solid #edf0f4;
}
.tlg-summary-item-name {
    color: var(--tlg-navy);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.5;
    overflow-wrap: anywhere;
}
.tlg-summary-qty { margin-top: 4px; color: var(--tlg-muted); font-size: 12px; }
.tlg-summary-price {
    flex-shrink: 0;
    color: var(--tlg-navy);
    font-size: 13px;
    font-weight: 800;
    white-space: nowrap;
}
.tlg-summary-line {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 17px;
    color: #475467;
    font-size: 13px;
}
.tlg-summary-line strong { color: var(--tlg-navy); text-align: right; }
.tlg-summary-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid #dce3eb;
}
.tlg-summary-total span { color: var(--tlg-navy); font-size: 15px; font-weight: 800; }
.tlg-summary-total strong {
    color: var(--tlg-orange-dark);
    font-size: 25px;
    letter-spacing: -.5px;
    font-variant-numeric: tabular-nums;
}
.tlg-summary-foot {
    margin-top: 20px;
    padding: 13px;
    border-radius: 9px;
    background: #f3f7fc;
    color: #53657a;
    font-size: 11px;
    line-height: 1.6;
}
.tlg-back-cart {
    display: block;
    margin-top: 18px;
    color: #174a7c;
    font-size: 13px;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
}
.tlg-back-cart:hover { text-decoration: underline; }
@media (max-width: 900px) {
    .tlg-checkout-grid { grid-template-columns: minmax(0, 1fr) 310px; gap: 17px; }
    .tlg-panel { padding: 21px; }
    .tlg-summary-head, .tlg-summary-body { padding-left: 17px; padding-right: 17px; }
}
@media (max-width: 720px) {
    .tlg-checkout { padding: 22px 13px 40px; }
    .tlg-checkout-header { margin-bottom: 18px; padding: 24px 20px; }
    .tlg-checkout-grid { grid-template-columns: minmax(0, 1fr); }
    .tlg-summary { position: static; grid-row: 1; }
    .tlg-checkout-main { grid-row: 2; }
    .tlg-panel { padding: 19px; }
}
@media (max-width: 480px) {
    .tlg-form-grid { grid-template-columns: minmax(0, 1fr); gap: 15px; }
    .tlg-field-full { grid-column: auto; }
    .tlg-shipping-heading { padding: 20px; }
    .tlg-shipping-body { padding: 17px; }
    .tlg-rate { flex-wrap: wrap; }
    .tlg-rate-price { margin-left: 30px; }
    .tlg-summary-total strong { font-size: 22px; }
}
</style>

<div class="tlg-checkout">
    <header class="tlg-checkout-header">
        <p class="tlg-checkout-eyebrow">THE LABEL GROUP</p>
        <h1>Checkout</h1>
        <p>Confirm your delivery details and review your order before placing it.</p>
        <div class="tlg-checkout-secure"><span aria-hidden="true">&#128274;</span> Secure order details &bull; US domestic shipping</div>
    </header>

    <form method="post">
        {% csrf_token %}

        <div class="tlg-checkout-grid">
            <div class="tlg-checkout-main">
                <section class="tlg-panel" aria-labelledby="tlg-customer-title">
                    <div class="tlg-panel-heading">
                        <span class="tlg-step">01</span>
                        <div>
                            <h2 id="tlg-customer-title">Customer information</h2>
                            <p>Tell us who is placing this order.</p>
                        </div>
                    </div>

                    <div class="tlg-form-grid">
                        <div class="tlg-field">
                            <label for="customer_name">Full name <span class="tlg-required">*</span></label>
                            <input type="text" id="customer_name" name="customer_name" autocomplete="name" required>
                        </div>
                        <div class="tlg-field">
                            <label for="customer_email">Email address <span class="tlg-required">*</span></label>
                            <input type="email" id="customer_email" name="customer_email" autocomplete="email" required>
                        </div>
                        <div class="tlg-field tlg-field-full">
                            <label for="customer_phone">Phone number <span class="tlg-required">*</span></label>
                            <input type="tel" id="customer_phone" name="customer_phone" autocomplete="tel" required>
                        </div>
                    </div>
                </section>

                <section class="tlg-panel" aria-labelledby="tlg-address-title">
                    <div class="tlg-panel-heading">
                        <span class="tlg-step">02</span>
                        <div>
                            <h2 id="tlg-address-title">Shipping address</h2>
                            <p>Enter the US address where your prints should be delivered.</p>
                        </div>
                    </div>

                    <div class="tlg-form-grid">
                        <div class="tlg-field tlg-field-full">
                            <label for="shipping_address">Street address <span class="tlg-required">*</span></label>
                            <textarea id="shipping_address" name="shipping_address" rows="2" autocomplete="street-address" required></textarea>
                        </div>
                        <div class="tlg-field">
                            <label for="shipping_city">City <span class="tlg-required">*</span></label>
                            <input type="text" id="shipping_city" name="shipping_city" autocomplete="address-level2" list="us-city-suggestions" required placeholder="Enter city">
                            <datalist id="us-city-suggestions"></datalist>
                        </div>
                        <div class="tlg-field">
                            <label for="shipping_state">State <span class="tlg-required">*</span></label>
                            <select id="shipping_state" name="shipping_state" autocomplete="address-level1" required>
                                <option value="">Choose a state</option>
                                <option value="AL">Alabama</option><option value="AK">Alaska</option>
                                <option value="AZ">Arizona</option><option value="AR">Arkansas</option>
                                <option value="CA">California</option><option value="CO">Colorado</option>
                                <option value="CT">Connecticut</option><option value="DE">Delaware</option>
                                <option value="DC">District of Columbia</option><option value="FL">Florida</option>
                                <option value="GA">Georgia</option><option value="HI">Hawaii</option>
                                <option value="ID">Idaho</option><option value="IL">Illinois</option>
                                <option value="IN">Indiana</option><option value="IA">Iowa</option>
                                <option value="KS">Kansas</option><option value="KY">Kentucky</option>
                                <option value="LA">Louisiana</option><option value="ME">Maine</option>
                                <option value="MD">Maryland</option><option value="MA">Massachusetts</option>
                                <option value="MI">Michigan</option><option value="MN">Minnesota</option>
                                <option value="MS">Mississippi</option><option value="MO">Missouri</option>
                                <option value="MT">Montana</option><option value="NE">Nebraska</option>
                                <option value="NV">Nevada</option><option value="NH">New Hampshire</option>
                                <option value="NJ">New Jersey</option><option value="NM">New Mexico</option>
                                <option value="NY">New York</option><option value="NC">North Carolina</option>
                                <option value="ND">North Dakota</option><option value="OH">Ohio</option>
                                <option value="OK">Oklahoma</option><option value="OR">Oregon</option>
                                <option value="PA">Pennsylvania</option><option value="RI">Rhode Island</option>
                                <option value="SC">South Carolina</option><option value="SD">South Dakota</option>
                                <option value="TN">Tennessee</option><option value="TX">Texas</option>
                                <option value="UT">Utah</option><option value="VT">Vermont</option>
                                <option value="VA">Virginia</option><option value="WA">Washington</option>
                                <option value="WV">West Virginia</option><option value="WI">Wisconsin</option>
                                <option value="WY">Wyoming</option>
                            </select>
                        </div>
                        <div class="tlg-field">
                            <label for="shipping_postal_code">ZIP code <span class="tlg-required">*</span></label>
                            <input type="text" id="shipping_postal_code" name="shipping_postal_code" autocomplete="postal-code" inputmode="numeric" pattern="[0-9]{5}(-[0-9]{4})?" title="Enter a US ZIP code, such as 01109." placeholder="e.g. 01109" required>
                        </div>
                        <div class="tlg-field">
                            <label for="shipping_country">Country</label>
                            <input type="text" id="shipping_country" name="shipping_country" value="United States" readonly required>
                        </div>
                        <div class="tlg-field tlg-field-full">
                            <label for="notes">Order notes <span style="font-weight:400;color:#667085">(optional)</span></label>
                            <textarea id="notes" name="notes" rows="3" placeholder="Special delivery instructions or anything we should know about your order."></textarea>
                        </div>
                    </div>
                </section>

                <section class="tlg-panel" style="padding:0;overflow:hidden" aria-labelledby="tlg-shipping-title">
                    <div class="tlg-shipping-heading">
                        <p class="tlg-checkout-eyebrow">DELIVERY OPTIONS</p>
                        <h2 id="tlg-shipping-title">Choose your shipping</h2>
                        <p>Review the available delivery option and shipping charge for your order.</p>
                        <span class="tlg-domestic-badge">UNITED STATES SHIPPING ONLY</span>
                    </div>
                    <div class="tlg-shipping-body">
                        <div class="tlg-origin">
                            <span class="tlg-origin-icon" aria-hidden="true">&#128230;</span>
                            <div>
                                <strong>Ships from Springfield, Massachusetts</strong>
                                <p>The Label Group LLC &bull; Springfield, MA 01109</p>
                            </div>
                        </div>

                        {% if shipping_rate_error %}
                            <div class="tlg-error" role="alert">
                                <strong>We couldn't calculate your shipping.</strong>
                                <p>{{ shipping_rate_error }}</p>
                                <p>Check your US delivery address and try again.</p>
                            </div>
                        {% endif %}

                        {% if shipping_rates %}
                            <fieldset class="tlg-rate-list">
                                <legend>Available delivery services</legend>
                                {% for rate in shipping_rates %}
                                    <label class="tlg-rate">
                                        <input type="radio"
                                               name="shipping_rate_id"
                                               value="{{ rate.object_id }}"
                                               data-amount="{{ rate.amount }}"
                                               data-currency="{{ rate.currency|default:'USD' }}"
                                               required>
                                        <span class="tlg-rate-info">
                                            <strong>{{ rate.provider }} &mdash; {{ rate.service }}</strong>
                                            {% if rate.estimated_days %}
                                                <small>Estimated delivery: {{ rate.estimated_days }} day(s)</small>
                                            {% else %}
                                                <small>Delivery estimate provided by the carrier, if available</small>
                                            {% endif %}
                                        </span>
                                        <span class="tlg-rate-price">${{ rate.amount|floatformat:2 }} {{ rate.currency|default:'USD' }}</span>
                                    </label>
                                {% endfor %}
                            </fieldset>
                            <p id="shippo-selection-help" class="tlg-help">Your selected shipping service will be included in the total.</p>
                        {% else %}
                            <div class="tlg-instructions">
                                <strong>Calculate your shipping</strong>
                                <p>Enter your delivery address, then calculate shipping to view the available option.</p>
                            </div>
                        {% endif %}

                        <button type="submit" name="action" value="get_rates" class="tlg-button tlg-button-calculate">
                            Calculate shipping
                        </button>

                        {% if shipping_rates %}
                            <div class="tlg-order-action">
                                <p>&#128274; Review your delivery service and total before placing your order.</p>
                                <button type="submit" name="action" value="place_order" id="checkout-place-order-button" class="tlg-button tlg-button-place">
                                    Place order <span aria-hidden="true">&rarr;</span>
                                </button>
                            </div>
                        {% else %}
                            <p class="tlg-help">Calculate shipping and select an available service before placing your order.</p>
                        {% endif %}
                    </div>
                </section>
            </div>

            <aside class="tlg-summary" aria-labelledby="tlg-summary-title">
                <div class="tlg-summary-head">
                    <h2 id="tlg-summary-title">Your order</h2>
                    <p>Review the items in your cart.</p>
                </div>
                <div class="tlg-summary-body">
                    {% for item in checkout_items %}
                        <div class="tlg-summary-item">
                            <div>
                                <div class="tlg-summary-item-name">{{ item.product.name }}</div>
                                <div class="tlg-summary-qty">Quantity: {{ item.quantity }}</div>
                            </div>
                            <div class="tlg-summary-price">${{ item.item_total|floatformat:2 }}</div>
                        </div>
                    {% empty %}
                        <p class="tlg-help">No items are currently listed in this order.</p>
                    {% endfor %}

                    <div class="tlg-summary-line">
                        <span>Subtotal</span>
                        <strong>${{ subtotal|floatformat:2 }}</strong>
                    </div>
                    <div class="tlg-summary-line">
                        <span>Shipping</span>
                        <strong id="checkout-shipping-amount" aria-live="polite">Calculate shipping</strong>
                    </div>
                    <div class="tlg-summary-total">
                        <span>Total (USD)</span>
                        <strong id="checkout-final-total" data-subtotal="{{ subtotal|floatformat:2 }}">${{ total|floatformat:2 }}</strong>
                    </div>
                    <div class="tlg-summary-foot">
                        Shipping shown here uses the rate returned by the current checkout system. Live UPS rates and label purchasing require a separate UPS integration.
                    </div>
                    <a href="{% url 'cart' %}" class="tlg-back-cart">&larr; Back to cart</a>
                </div>
            </aside>
        </div>
    </form>
</div>

<script id="tlg-checkout-total">
(function () {
    function initCheckout() {
        const totalElement = document.getElementById("checkout-final-total");
        const shippingElement = document.getElementById("checkout-shipping-amount");
        const radios = document.querySelectorAll('input[name="shipping_rate_id"]');

        if (!totalElement || !shippingElement) return;

        const subtotal = Number.parseFloat(totalElement.dataset.subtotal || "0");
        const money = function (value) {
            return "$" + value.toLocaleString("en-US", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        };

        function updateTotal() {
            const selected = document.querySelector('input[name="shipping_rate_id"]:checked');

            if (!selected) {
                shippingElement.textContent = "Calculate shipping";
                totalElement.textContent = money(subtotal);
                return;
            }

            const shipping = Number.parseFloat(selected.dataset.amount || "");
            const currency = (selected.dataset.currency || "USD").toUpperCase();

            if (!Number.isFinite(shipping) || shipping < 0 || currency !== "USD") {
                shippingElement.textContent = "Check selected rate";
                totalElement.textContent = money(subtotal);
                return;
            }

            shippingElement.textContent = money(shipping) + " USD";
            totalElement.textContent = money(subtotal + shipping);

            const help = document.getElementById("shippo-selection-help");
            if (help) {
                const label = selected.closest("label");
                const service = label ? label.querySelector(".tlg-rate-info strong") : null;
                help.textContent = service
                    ? "Selected: " + service.textContent.trim() + ". Shipping is included in the displayed total."
                    : "Shipping is included in the displayed total.";
            }
        }

        radios.forEach(function (radio) {
            radio.addEventListener("change", updateTotal);
        });

        const checked = document.querySelector('input[name="shipping_rate_id"]:checked');
        if (!checked && radios.length > 0) radios[0].checked = true;
        updateTotal();
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initCheckout);
    } else {
        initCheckout();
    }
})();
</script>

