            "name": address.get("name", ""),
            "street1": address.get("street1", ""),
            "city": address.get("city", "").split(",")[0].strip(),
            "state": address.get("state", ""),
            "zip": address.get("zip", ""),
            "country": "US",
            "phone": address.get("phone", ""),
            "email": address.get("email", ""),
        }

