                "The shipping service returned an unexpected response. Please try again."
            ) from exc

        if not response.ok:
            logging.getLogger(__name__).error(
                "Shippo rate request returned HTTP %s: %s",
                response.status_code,
                str(data.get("detail", data))[:1000]
                if isinstance(data, dict) else str(data)[:1000],
            )
            if response.status_code == 401:
                raise ValueError(
                    "Shippo rejected the API token. Check your token in the "
                    "server environment and restart Django."
                )
            raise ValueError(
