                    "weight": float(package["weight"]),
                    "mass_unit": "lb",
                }
                for package in packages
            ]
        except (KeyError, TypeError, ValueError, OverflowError) as exc:
            raise ValueError(
                "A parcel has invalid shipping measurements. Check the product "
                "weights and dimensions before calculating rates."
            ) from exc

        payload = {
            "address_from": address_from,
