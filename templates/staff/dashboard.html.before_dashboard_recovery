{% extends "staff/base.html" %}

{% block content %}
<style>
.dashboard {
    --navy: #0b1f3a;
    --navy-dark: #06152a;
    --orange: #f47b20;
    --orange-dark: #d9620d;
    --muted: #64748b;
    --line: #e2e8f0;
    --surface: #ffffff;
    --page: #f4f7fb;
    color: var(--navy);
    width: 100%;
    max-width: 1500px;
    margin: 0 auto;
    padding: 24px;
    box-sizing: border-box;
    font-family: Arial, Helvetica, sans-serif;
}

.dashboard *,
.dashboard *::before,
.dashboard *::after {
    box-sizing: border-box;
}

.dashboard a {
    color: inherit;
    text-decoration: none;
}

.dashboard .dashboard-hero {
    position: relative;
    overflow: hidden;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
    padding: 32px;
    border-radius: 20px;
    background: linear-gradient(125deg, var(--navy-dark), var(--navy) 68%, #173d66);
    color: #ffffff;
    box-shadow: 0 12px 30px rgba(6, 21, 42, .14);
}

.dashboard .dashboard-hero::after {
    content: "";
    position: absolute;
    width: 240px;
    height: 240px;
    right: -75px;
    top: -100px;
    border: 35px solid rgba(244, 123, 32, .17);
    border-radius: 50%;
    pointer-events: none;
}

.dashboard .hero-copy,
.dashboard .hero-actions {
    position: relative;
    z-index: 1;
}

.dashboard .eyebrow {
    margin: 0 0 10px;
    color: #ffb16f;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
}

.dashboard .dashboard-hero h1 {
    margin: 0 0 10px;
    color: #ffffff;
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.15;
    font-weight: 800;
}

.dashboard .dashboard-hero p {
    margin: 0;
    color: #dbe7f5;
    line-height: 1.6;
}

.dashboard .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.dashboard .btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 42px;
    padding: 11px 16px;
    border: 1px solid transparent;
    border-radius: 9px;
    font-size: 13px;
    font-weight: 750;
    transition: transform .2s ease, background .2s ease;
}

.dashboard .btn:hover,
.dashboard .quick-link:hover {
    transform: translateY(-2px);
}

.dashboard .btn-primary {
    background: var(--orange);
    color: #ffffff;
}

.dashboard .btn-primary:hover {
    background: var(--orange-dark);
}

.dashboard .btn-light {
    background: #ffffff;
    color: var(--navy);
}

.dashboard .btn-outline {
    border-color: rgba(255,255,255,.35);
    background: rgba(255,255,255,.08);
    color: #ffffff;
}

.dashboard .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin: 30px 0 16px;
}

.dashboard .section-heading h2 {
    margin: 0;
    color: var(--navy);
    font-size: 20px;
    font-weight: 800;
}

.dashboard .section-heading p {
    margin: 5px 0 0;
    color: var(--muted);
    font-size: 13px;
}

.dashboard .stats {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
}

.dashboard article.stat {
    min-width: 0;
    margin: 0;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 15px;
    background: var(--surface);
    box-shadow: 0 5px 16px rgba(11, 31, 58, .04);
}

.dashboard .stat-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
}

.dashboard .stat-label {
    color: var(--muted);
    font-size: 12px;
    font-weight: 750;
    line-height: 1.4;
}

.dashboard .stat-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 38px;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: #fff0e5;
    color: var(--orange-dark);
    font-size: 19px;
    font-weight: 800;
}

.dashboard .stat-icon:empty::before {
    content: "\2022";
}

.dashboard .stat-icon.blue {
    background: #eaf2ff;
    color: #2563eb;
}

.dashboard .stat-icon.blue:empty::before {
    content: "\2197";
}

.dashboard .stat-icon.green {
    background: #e5f8ed;
    color: #16834a;
}

.dashboard .stat-icon.green:empty::before {
    content: "\2713";
}

.dashboard .stat-icon.purple {
    background: #f1eafe;
    color: #7c3aed;
}

.dashboard .stat-icon.purple:empty::before {
    content: "+";
}

.dashboard .stat-number {
    margin: 0;
    color: var(--navy);
    font-size: clamp(25px, 2.5vw, 34px);
    line-height: 1.1;
    font-weight: 850;
    overflow-wrap: anywhere;
}

.dashboard .stat-note {
    margin-top: 8px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
}

.dashboard .pipeline {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
}

.dashboard .pipeline-item {
    padding: 17px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #ffffff;
}

.dashboard .pipeline-item span {
    display: block;
    margin-bottom: 8px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
}

.dashboard .pipeline-item strong {
    color: var(--navy);
    font-size: 25px;
    font-weight: 850;
}

.dashboard .columns {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr);
    gap: 20px;
    margin-top: 28px;
}

.dashboard .panel {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: #ffffff;
    box-shadow: 0 5px 16px rgba(11, 31, 58, .04);
}

.dashboard .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 20px 22px;
    border-bottom: 1px solid var(--line);
}

.dashboard .panel-header h2 {
    margin: 0;
    color: var(--navy);
    font-size: 17px;
    font-weight: 800;
}

.dashboard .panel-header a {
    color: var(--orange-dark);
    font-size: 12px;
    font-weight: 800;
}

.dashboard .panel-body {
    padding: 8px 22px;
}

.dashboard .record {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 17px 0;
    border-bottom: 1px solid #edf1f6;
}

.dashboard .record:last-child {
    border-bottom: 0;
}

.dashboard .record-main {
    min-width: 0;
}

.dashboard .record-title {
    margin: 0 0 5px;
    color: var(--navy);
    font-size: 13px;
    font-weight: 800;
    overflow-wrap: anywhere;
}

.dashboard .record-meta {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
    overflow-wrap: anywhere;
}

.dashboard .record-status {
    display: inline-block;
    flex: 0 0 auto;
    padding: 6px 9px;
    border-radius: 999px;
    background: #fff0e5;
    color: #a74708;
    font-size: 10px;
    font-weight: 800;
}

.dashboard .activity-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 34px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #eaf2ff;
    color: #2563eb;
    font-size: 13px;
    font-weight: 800;
}

.dashboard .activity-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 15px 0;
    border-bottom: 1px solid #edf1f6;
}

.dashboard .activity-row:last-child {
    border-bottom: 0;
}

.dashboard .activity-row p {
    margin: 0 0 5px;
    color: var(--navy);
    font-size: 13px;
    line-height: 1.5;
    overflow-wrap: anywhere;
}

.dashboard .activity-row small {
    color: var(--muted);
    font-size: 11px;
}

.dashboard .empty-state {
    padding: 28px 12px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
    text-align: center;
}

.dashboard .quick-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 15px;
}

.dashboard .quick-link {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 13px;
    background: #ffffff;
    transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
}

.dashboard .quick-link:hover {
    border-color: #f4b17f;
    box-shadow: 0 8px 20px rgba(11, 31, 58, .07);
}

.dashboard .quick-link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 42px;
    width: 42px;
    height: 42px;
    border-radius: 11px;
    background: #fff0e5;
    color: var(--orange-dark);
    font-size: 20px;
    font-weight: 800;
}

.dashboard .quick-link-text {
    flex: 1;
    min-width: 0;
}

.dashboard .quick-link-text strong {
    display: block;
    margin-bottom: 5px;
    color: var(--navy);
    font-size: 13px;
    font-weight: 800;
}

.dashboard .quick-link-text small {
    display: block;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.5;
}

.dashboard .quick-link-arrow {
    color: var(--orange-dark);
    font-size: 19px;
    font-weight: 800;
}

.dashboard .admin-panel {
    padding: 22px;
    border: 1px solid #d8e2f0;
    border-radius: 16px;
    background: #f8faff;
}

.dashboard .admin-panel h2 {
    margin: 0 0 7px;
    color: var(--navy);
    font-size: 19px;
}

.dashboard .admin-panel > p {
    margin: 0 0 18px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
}

.dashboard .admin-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 18px;
}

.dashboard .admin-stat {
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #ffffff;
}

.dashboard .admin-stat span {
    display: block;
    margin-bottom: 7px;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.4;
}

.dashboard .admin-stat strong {
    color: var(--navy);
    font-size: 23px;
    font-weight: 850;
}

.dashboard .admin-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.dashboard .admin-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 11px 14px;
    border: 1px solid #d8e2f0;
    border-radius: 8px;
    background: #ffffff;
    color: var(--navy);
    font-size: 12px;
    font-weight: 800;
}

.dashboard .admin-links a:hover {
    border-color: var(--orange);
    color: var(--orange-dark);
}

@media (max-width: 1100px) {
    .dashboard .stats {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .dashboard .pipeline {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .dashboard .admin-stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 760px) {
    .dashboard {
        padding: 15px;
    }

    .dashboard .dashboard-hero {
        padding: 24px 20px;
    }

    .dashboard .stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 11px;
    }

    .dashboard article.stat {
        padding: 15px;
    }

    .dashboard .columns {
        grid-template-columns: minmax(0, 1fr);
    }

    .dashboard .quick-links {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dashboard .pipeline {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 480px) {
    .dashboard .stats,
    .dashboard .quick-links,
    .dashboard .pipeline,
    .dashboard .admin-stats {
        grid-template-columns: minmax(0, 1fr);
    }

    .dashboard .hero-actions {
        width: 100%;
    }

    .dashboard .hero-actions .btn {
        flex: 1;
    }

    .dashboard .panel-header,
    .dashboard .panel-body {
        padding-left: 15px;
        padding-right: 15px;
    }

    .dashboard .record {
        gap: 8px;
    }
}
</style>

<div class="dashboard">
    <section class="dashboard-hero">
        <div class="hero-copy">
            <p class="eyebrow">THE LABEL GROUP | OPERATIONS</p>
            <h1>Welcome, {{ request.user.first_name|default:request.user.username|title }}</h1>
            <p>Your operations overview. Keep products, orders, customer requests and team activity moving.</p>
        </div>

        <div class="hero-actions">
            <a class="btn btn-primary" href="/staff/orders/">Manage Orders</a>
            <a class="btn btn-light" href="/staff/quotes/">Review Quotes</a>
            <a class="btn btn-outline" href="/staff/profile/">My Profile</a>
        </div>
    </section>

    <section>
        <div class="section-heading">
            <div>
                <h2>Business Overview</h2>
                <p>A snapshot of your store's current activity.</p>
            </div>
        </div>

        <div class="stats">
            <article class="stat">
                <div class="stat-top">
                    <span class="stat-label">Total Products</span>
                    <span class="stat-icon blue" aria-hidden="true"></span>
                </div>
                <p class="stat-number">{{ total_products|default:0 }}</p>
                <div class="stat-note">Products in your catalogue</div>
            </article>

            <article class="stat">
                <div class="stat-top">
                    <span class="stat-label">Available Products</span>
                    <span class="stat-icon green" aria-hidden="true"></span>
                </div>
                <p class="stat-number">{{ available_products|default:0 }}</p>
                <div class="stat-note">Products available to customers</div>
            </article>

            <article class="stat">
                <div class="stat-top">
                    <span class="stat-label">Total Quote Requests</span>
                    <span class="stat-icon purple" aria-hidden="true"></span>
                </div>
                <p class="stat-number">{{ total_quotes|default:0 }}</p>
                <div class="stat-note">Customer quote enquiries</div>
            </article>

            <article class="stat">
                <div class="stat-top">
                    <span class="stat-label">New Quotes</span>
                    <span class="stat-icon" aria-hidden="true"></span>
                </div>
                <p class="stat-number">{{ new_quotes|default:0 }}</p>
                <div class="stat-note">Requests awaiting review</div>
            </article>

            <article class="stat">
                <div class="stat-top">
                    <span class="stat-label">Total Orders</span>
                    <span class="stat-icon blue" aria-hidden="true"></span>
                </div>
                <p class="stat-number">{{ total_orders|default:0 }}</p>
                <div class="stat-note">Customer orders received</div>
            </article>
        </div>
    </section>

    <section>
        <div class="section-heading">
            <div>
                <h2>Quote Pipeline</h2>
                <p>Track customer requests from arrival to completion.</p>
            </div>
            <a class="btn btn-primary" href="/staff/quotes/">Open Quote Requests</a>
        </div>

        <div class="pipeline">
            <div class="pipeline-item">
                <span>New Requests</span>
                <strong>{{ new_quotes|default:0 }}</strong>
            </div>
            <div class="pipeline-item">
                <span>Under Review</span>
                <strong>{{ reviewing_quotes|default:0 }}</strong>
            </div>
            <div class="pipeline-item">
                <span>Quotes Sent</span>
                <strong>{{ quoted_quotes|default:0 }}</strong>
            </div>
            <div class="pipeline-item">
                <span>In Production</span>
                <strong>{{ production_quotes|default:0 }}</strong>
            </div>
            <div class="pipeline-item">
                <span>Completed</span>
                <strong>{{ completed_quotes|default:0 }}</strong>
            </div>
        </div>
    </section>

    <section>
        <div class="section-heading">
            <div>
                <h2>Quick Access</h2>
                <p>Jump straight to the tools you use most.</p>
            </div>
        </div>

        <div class="quick-links">
            <a class="quick-link" href="/staff/products/">
                <span class="quick-link-icon" aria-hidden="true">+</span>
                <span class="quick-link-text">
                    <strong>Products</strong>
                    <small>Add, edit and manage your print catalogue.</small>
                </span>
                <span class="quick-link-arrow" aria-hidden="true">&rsaquo;</span>
            </a>

            <a class="quick-link" href="/staff/customers/">
                <span class="quick-link-icon" aria-hidden="true">&#9786;</span>
                <span class="quick-link-text">
                    <strong>Customers</strong>
                    <small>View customer information and enquiries.</small>
                </span>
                <span class="quick-link-arrow" aria-hidden="true">&rsaquo;</span>
            </a>

            <a class="quick-link" href="/staff/orders/">
                <span class="quick-link-icon" aria-hidden="true">&#9635;</span>
                <span class="quick-link-text">
                    <strong>Orders</strong>
                    <small>Review and manage incoming orders.</small>
                </span>
                <span class="quick-link-arrow" aria-hidden="true">&rsaquo;</span>
            </a>
        </div>
    </section>

    <div class="columns">
        <section class="panel">
            <div class="panel-header">
                <h2>Recent Quote Requests</h2>
                <a href="/staff/quotes/">View All &rsaquo;</a>
            </div>

            <div class="panel-body">
                {% for quote in recent_quotes %}
                    <div class="record">
                        <div class="record-main">
                            <p class="record-title">
                                {{ quote.company_name|default:quote.customer_name|default:"Customer enquiry" }}
                            </p>
                            <p class="record-meta">
                                Quote #{{ quote.pk }} &middot;
                                {{ quote.created_at|date:"M d, Y" }}
                            </p>
                        </div>
                        <span class="record-status">
                            {% if quote.get_status_display %}
                                {{ quote.get_status_display }}
                            {% else %}
                                {{ quote.status|default:"New" }}
                            {% endif %}
                        </span>
                    </div>
                {% empty %}
                    <div class="empty-state">
                        No recent quote requests to display.
                    </div>
                {% endfor %}
            </div>
        </section>

        <section class="panel">
            <div class="panel-header">
                <h2>Team Activity</h2>
                {% if request.user.is_superuser %}
                    <a href="/staff/activity-log/">View Activity Log &rsaquo;</a>
                {% endif %}
            </div>

            <div class="panel-body">
                {% for activity in recent_activity %}
                    <div class="activity-row">
                        <span class="activity-dot" aria-hidden="true">&#8226;</span>
                        <div>
                            <p>
                                <strong>
                                    {% if activity.staff.user.get_full_name %}
                                        {{ activity.staff.user.get_full_name }}
                                    {% else %}
                                        {{ activity.staff.user.username|default:"Team member" }}
                                    {% endif %}
                                </strong>
                                {% if activity.description %}
                                    {{ activity.description }}
                                {% elif activity.action %}
                                    {{ activity.action }}
                                {% else %}
                                    recorded an activity
                                {% endif %}
                            </p>
                            <small>
                                {% if activity.created_at %}
                                    {{ activity.created_at|date:"M d, Y · H:i" }}
                                {% elif activity.timestamp %}
                                    {{ activity.timestamp|date:"M d, Y · H:i" }}
                                {% endif %}
                            </small>
                        </div>
                    </div>
                {% empty %}
                    <div class="empty-state">
                        No recent team activity to display.
                    </div>
                {% endfor %}
            </div>
        </section>
    </div>

    {% if request.user.is_superuser %}
        <section>
            <div class="section-heading">
                <div>
                    <h2>Boss Control Center</h2>
                    <p>Manage staff access, monitor activity and coordinate operations.</p>
                </div>
            </div>

            <div class="admin-panel">
                <h2>Administration</h2>
                <p>Staff management and operational oversight for The Label Group.</p>

                <div class="admin-stats">
                    <div class="admin-stat">
                        <span>Approved Staff</span>
                        <strong>{{ approved_staff|default:0 }}</strong>
                    </div>
                    <div class="admin-stat">
                        <span>Pending Staff</span>
                        <strong>{{ pending_staff|default:0 }}</strong>
                    </div>
                    <div class="admin-stat">
                        <span>Approved Quotes</span>
                        <strong>{{ approved_quotes|default:0 }}</strong>
                    </div>
                    <div class="admin-stat">
                        <span>Quotes Sent</span>
                        <strong>{{ quoted_quotes|default:0 }}</strong>
                    </div>
                </div>

                <div class="admin-links">
                    <a href="/staff/staff-management/">Manage Staff</a>
                    <a href="/staff/activity-log/">Staff Activity Log</a>
                    <a href="/staff/calendar-orders/">Orders Calendar</a>
                </div>
            </div>
        </section>
    {% endif %}
</div>
{% endblock %}