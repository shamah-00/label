{% extends "staff/base.html" %}
{% block content %}
<div class="container" style="max-width:850px; margin:30px auto; background:white; padding:30px; border-radius:8px; box-shadow:0 2px 5px rgba(0,0,0,0.1);">
    <p><a href="{% url 'staff_orders' %}" class="back-link">&larr; Back to Orders List</a></p>
    
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #f0f2f5; padding-bottom: 15px; margin-bottom: 20px;">
        <h1 style="margin: 0; color: #333;">Order #{{ order.pk }}</h1>
        <span class="badge" style="padding: 6px 12px; border-radius: 4px; font-weight: bold; background: {% if order.status == 'completed' %}#d1fae5; color: #065f46{% else %}#dbeafe; color: #1e40af{% endif %}; text-transform: uppercase;">
            {{ order.status }}
        </span>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px;">
        <div style="background: #f8f9fa; padding: 20px; border-radius: 6px;">
            <h3 style="margin-top: 0; color: #333;">Customer Details</h3>
            <p><strong>Name:</strong> {{ order.customer_name|default:"—" }}</p>
            <p><strong>Email:</strong> {{ order.customer_email|default:"—" }}</p>
            <p><strong>Phone:</strong> {{ order.customer_phone|default:"—" }}</p>
        </div>
        <div style="background: #f8f9fa; padding: 20px; border-radius: 6px;">
            <h3 style="margin-top: 0; color: #333;">Shipping & Order Info</h3>
            <p><strong>Address:</strong> {{ order.shipping_address|default:"—" }}</p>
            <p><strong>Total:</strong> {{ order.currency|default:"$" }} {{ order.total }}</p>
            <p><strong>Date:</strong> {{ order.created_at|date:"M d, Y H:i" }}</p>
        </div>
    </div>

    {% if order.status != 'completed' %}
    <form method="POST" style="margin-top: 20px;">
        {% csrf_token %}
        <input type="hidden" name="action" value="complete">
        <button type="submit" style="background: #10b981; color: white; border: none; padding: 14px 20px; font-size: 1.05rem; font-weight: bold; border-radius: 6px; cursor: pointer; width: 100%; box-shadow: 0 2px 4px rgba(16, 185, 129, 0.3);">
            ? Confirm Order Handled Successfully
        </button>
    </form>
    {% else %}
    <div style="background: #d1fae5; color: #065f46; padding: 15px; border-radius: 6px; text-align: center; font-weight: bold; font-size: 1.05rem; margin-top: 20px; border: 1px solid #a7f3d0;">
        ? Order Successfully Handled & Completed
    </div>
    {% endif %}
</div>
{% endblock %}
