{% extends "staff/base.html" %}
{% block content %}
<style>
.order-page{max-width:1200px;margin:25px auto;padding:0 18px 40px;color:#0b1f3a}
.order-header,.order-row{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}
.order-grid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(270px,1fr);gap:20px;align-items:start}
.order-stack{display:grid;gap:20px;min-width:0}
.order-card{background:#fff;border:1px solid #e1e7ef;border-radius:12px;overflow:hidden;box-shadow:0 3px 12px #0b1f3a0a}
.order-heading{padding:17px 20px;font-size:16px;font-weight:800;border-bottom:1px solid #e1e7ef}
.order-body{padding:20px}
.order-info{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
.order-label{display:block;color:#68778a;font-size:12px;margin-bottom:6px}
.order-value{font-size:14px;font-weight:650;overflow-wrap:anywhere}
.order-field{margin-bottom:17px}
.order-field label{display:block;font-size:13px;font-weight:750;margin-bottom:7px}
.order-field select,.order-field textarea{width:100%;padding:12px;border:1px solid #cfd8e3;border-radius:7px;background:white;color:#0b1f3a;font:inherit}
.order-field textarea{min-height:120px;resize:vertical}
.order-btn{display:inline-block;padding:11px 16px;border:0;border-radius:7px;text-decoration:none;font-weight:750;cursor:pointer}
.order-back{border:1px solid #dce3eb;color:#0b1f3a;background:#fff}
.order-save{background:#f47b20;color:#fff;width:100%}
.order-save:hover{background:#d9620d}
.order-table-wrap{overflow-x:auto}
.order-table{width:100%;border-collapse:collapse;font-size:13px}
.order-table th{background:#f5f7fa;color:#526176;text-align:left;padding:12px;white-space:nowrap}
.order-table td{padding:14px 12px;border-top:1px solid #e1e7ef;vertical-align:top}
.order-table th:last-child,.order-table td:last-child{text-align:right}
.order-muted{font-size:13px;color:#68778a}
.order-total{display:flex;justify-content:space-between;gap:12px;margin:12px 0;font-size:14px}
.order-grand{border-top:1px solid #e1e7ef;padding-top:16px;margin-top:16px;font-size:20px;font-weight:850}
.order-badge{display:inline-block;border-radius:30px;padding:6px 10px;background:#fff0dd;color:#97500b;font-size:12px;font-weight:800}
.order-message{padding:12px;margin:8px 0;border-radius:7px;background:#dcfce7;color:#166534}
@media(max-width:800px){.order-grid{grid-template-columns:1fr}}
@media(max-width:520px){.order-info{grid-template-columns:1fr}.order-body{padding:15px}.order-page{padding:0 10px 25px}}
</style>

<div class="order-page">
    <header class="order-header" style="margin-bottom:24px">
        <div>
            <h1 style="margin:0 0 7px">Order #{{ order.id }}</h1>
            <div class="order-muted">
                Order submitted {{ order.created_at|date:"F j, Y H:i" }}
            </div>
        </div>
        <a class="order-btn order-back" href="{% url 'staff_orders' %}">&larr; Back to Orders</a>
    </header>

    {% if messages %}
        {% for message in messages %}
            <div class="order-message">{{ message }}</div>
        {% endfor %}
    {% endif %}

    <div class="order-grid">
        <div class="order-stack">
            <section class="order-card">
                <div class="order-heading">Customer Information</div>
                <div class="order-body order-info">
                    <div><span class="order-label">Customer Name</span><div class="order-value">{{ order.customer_name|default:"Not provided" }}</div></div>
                    <div><span class="order-label">Company</span><div class="order-value">{{ order.company_name|default:"Not provided" }}</div></div>
                    <div><span class="order-label">Email</span><div class="order-value">{{ order.customer_email|default:"Not provided" }}</div></div>
                    <div><span class="order-label">Phone</span><div class="order-value">{{ order.customer_phone|default:"Not provided" }}</div></div>
                </div>
            </section>

            <section class="order-card">
                <div class="order-heading">Shipping Information</div>
                <div class="order-body order-info">
                    <div><span class="order-label">Street Address</span><div class="order-value">{{ order.shipping_address|default:"Not provided" }}</div></div>
                    <div><span class="order-label">Address Continued</span><div class="order-value">{{ order.shipping_address2|default:"Not provided" }}</div></div>
                    <div><span class="order-label">City</span><div class="order-value">{{ order.shipping_city|default:"Not provided" }}</div></div>
                    <div><span class="order-label">State</span><div class="order-value">{{ order.shipping_state|default:"Not provided" }}</div></div>
                    <div><span class="order-label">Postal Code</span><div class="order-value">{{ order.shipping_postal_code|default:"Not provided" }}</div></div>
                    <div><span class="order-label">Country</span><div class="order-value">{{ order.shipping_country|default:"Not provided" }}</div></div>
                </div>
            </section>

            <section class="order-card">
                <div class="order-heading">Ordered Products</div>
                <div class="order-table-wrap">
                    <table class="order-table">
                        <thead><tr><th>Product</th><th>Quantity</th><th>Unit Price</th><th>Line Total</th></tr></thead>
                        <tbody>
                        {% for item in items %}
                            <tr>
                                <td><strong>{{ item.product }}</strong></td>
                                <td>{{ item.quantity }}</td>
                                <td>${{ item.unit_price|default_if_none:"0.00"|floatformat:2 }}</td>
                                <td><strong>${{ item.line_total|default_if_none:"0.00"|floatformat:2 }}</strong></td>
                            </tr>
                        {% empty %}
                            <tr><td colspan="4">Product items are not available in this view.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="order-card">
                <div class="order-heading">Order Notes & Shipping Details</div>
                <div class="order-body">
                    {% if order.notes %}
                        <div style="white-space:pre-wrap;overflow-wrap:anywhere">{{ order.notes }}</div>
                    {% else %}
                        <div class="order-muted">No order notes have been added.</div>
                    {% endif %}
                </div>
            </section>
        </div>

        <aside class="order-stack">
            <section class="order-card">
                <div class="order-heading">Order Status & Update</div>
                <div class="order-body">
                    <span class="order-label">Current status</span>
                    <span class="order-badge">{{ order.get_status_display|default:order.status|title }}</span>

                    <form method="post" style="margin-top:22px" id="order-update-form">
                        {% csrf_token %}
                        <div class="order-field">
                            <label for="id_status">Order Status</label>
                            <select name="status" id="id_status" required>
                                {% for value,label in status_choices %}
                                    <option value="{{ value }}" {% if order.status == value %}selected{% endif %}>{{ label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="order-field">
                            <label for="id_notes">Staff Notes</label>
                            <textarea name="notes" id="id_notes" placeholder="Add internal order notes...">{{ order.notes|default:"" }}</textarea>
                        </div>
                        <button class="order-btn order-save" type="submit" id="save-order-btn">Save Order Update</button>
                    </form>
                </div>
            </section>

            <section class="order-card">
                <div class="order-heading">Order Summary</div>
                <div class="order-body">
                    <div class="order-total"><span>Subtotal</span><strong>${{ order.subtotal|default:order.total_amount|floatformat:2 }}</strong></div>
                    <div class="order-total"><span>Shipping</span><strong>${{ order.shipping_amount|default:"0.00" }}</strong></div>
                    <div class="order-total order-grand"><span>Total</span><strong>${{ order.total_amount|default:0|floatformat:2 }}</strong></div>
                    <div class="order-muted">Currency: USD</div>
                </div>
            </section>
        </aside>
    </div>
</div>

<script>
document.getElementById("order-update-form")?.addEventListener("submit", function () {
    const button = document.getElementById("save-order-btn");
    if (button) {
        button.disabled = true;
        button.textContent = "Saving...";
    }
});
</script>
{% endblock %}
