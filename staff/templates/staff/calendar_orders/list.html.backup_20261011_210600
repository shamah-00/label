{% load static %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Collection Calendar Orders | THE LABEL GROUP</title>

    <style>
        :root {
            --navy: #08233f;
            --blue: #0d4f87;
            --orange: #f58220;
            --light: #f4f6f8;
            --white: #ffffff;
            --text: #182838;
            --border: #d9e0e7;
            --green: #218739;
            --red: #c62828;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: var(--light);
            color: var(--text);
        }

        .topbar {
            background: var(--navy);
            color: white;
            padding: 10px 20px;
            text-align: center;
            font-size: 14px;
        }

        .header {
            background: white;
            border-bottom: 1px solid var(--border);
        }

        .header-inner {
            max-width: 1250px;
            margin: auto;
            min-height: 95px;
            padding: 15px 25px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .logo {
            width: 220px;
            max-width: 100%;
        }

        .header-title {
            text-align: right;
        }

        .header-title h1 {
            margin: 0;
            color: var(--navy);
            font-size: 26px;
        }

        .header-title p {
            margin: 6px 0 0;
            color: #687785;
            font-size: 14px;
        }

        .page {
            max-width: 1250px;
            margin: 35px auto;
            padding: 0 25px;
        }

        .back-link {
            display: inline-block;
            margin-bottom: 20px;
            color: var(--blue);
            text-decoration: none;
            font-weight: bold;
        }

        .back-link:hover {
            color: var(--orange);
        }

        .card {
            background: white;
            border-radius: 14px;
            box-shadow: 0 6px 25px rgba(8, 35, 63, 0.08);
            overflow: hidden;
        }

        .card-header {
            padding: 22px 25px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .card-header h2 {
            margin: 0;
            color: var(--navy);
            font-size: 21px;
        }

        .count {
            background: var(--blue);
            color: white;
            padding: 7px 13px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
        }

        .filters {
            padding: 20px 25px;
            background: #f9fafb;
            border-bottom: 1px solid var(--border);
        }

        .filters form {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .filters input,
        .filters select {
            padding: 11px 13px;
            border: 1px solid var(--border);
            border-radius: 7px;
            background: white;
            font-size: 14px;
        }

        .filters input {
            min-width: 280px;
            flex: 1;
        }

        .filter-button {
            padding: 11px 20px;
            border: none;
            border-radius: 7px;
            background: var(--orange);
            color: white;
            font-weight: bold;
            cursor: pointer;
        }

        .filter-button:hover {
            background: #d9680b;
        }

        .clear-button {
            display: inline-flex;
            align-items: center;
            padding: 11px 18px;
            border-radius: 7px;
            background: var(--navy);
            color: white;
            text-decoration: none;
            font-weight: bold;
            font-size: 14px;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 950px;
        }

        th {
            background: var(--navy);
            color: white;
            text-align: left;
            padding: 15px 14px;
            font-size: 13px;
            white-space: nowrap;
        }

        td {
            padding: 15px 14px;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
            font-size: 14px;
        }

        tbody tr {
            transition: background 0.2s ease;
        }

        tbody tr:hover {
            background: #f8fbfd;
        }

        .order-link {
            display: block;
            color: inherit;
            text-decoration: none;
        }

        .order-link:hover .request-number {
            color: var(--orange);
        }

        .request-number {
            color: var(--blue);
            font-weight: bold;
        }

        .company {
            font-weight: bold;
            color: var(--navy);
        }

        .customer {
            color: #586977;
            line-height: 1.5;
        }

        .quantity {
            font-weight: bold;
            color: var(--navy);
        }

        .status {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
            text-transform: capitalize;
        }

        .status-new {
            background: #fff3cd;
            color: #856404;
        }

        .status-in_progress {
            background: #dceeff;
            color: var(--blue);
        }

        .status-completed {
            background: #e8f7ed;
            color: var(--green);
        }

        .status-cancelled {
            background: #fde8e8;
            color: var(--red);
        }

        .view-button {
            display: inline-block;
            padding: 8px 12px;
            border-radius: 6px;
            background: var(--blue);
            color: white;
            text-decoration: none;
            font-size: 12px;
            font-weight: bold;
            white-space: nowrap;
        }

        .view-button:hover {
            background: var(--orange);
        }

        .empty {
            padding: 60px 25px;
            text-align: center;
        }

        .empty h3 {
            margin: 0 0 10px;
            color: var(--navy);
        }

        .empty p {
            margin: 0;
            color: #687785;
        }

        .footer {
            margin-top: 50px;
            background: var(--navy);
            color: white;
            text-align: center;
            padding: 30px 20px;
        }

        .footer img {
            width: 190px;
            max-width: 100%;
            margin-bottom: 12px;
        }

        .footer p {
            margin: 0;
            color: #dce5ed;
            font-size: 14px;
        }

        @media (max-width: 700px) {

            .header-inner {
                flex-direction: column;
                text-align: center;
            }

            .header-title {
                text-align: center;
            }

            .header-title h1 {
                font-size: 22px;
            }

            .page {
                padding: 0 15px;
            }

            .card-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .filters input {
                min-width: 100%;
            }

            .filters select,
            .filter-button,
            .clear-button {
                width: 100%;
            }
        }
    </style>
<!-- TLG-STAFF-PROFESSIONAL-THEME-V1 -->
<style>
:root {
    --tlg-navy: #0b1f3a;
    --tlg-navy-dark: #06152a;
    --tlg-orange: #f47b20;
    --tlg-orange-dark: #d9620d;
    --tlg-bg: #f3f6fa;
    --tlg-white: #ffffff;
    --tlg-text: #263449;
    --tlg-muted: #68778b;
    --tlg-border: #e0e6ee;
    --tlg-radius: 12px;
    --tlg-shadow: 0 5px 20px rgba(11,31,58,.07);
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
    margin: 0 !important;
    padding: 0 !important;
    background: var(--tlg-bg) !important;
    color: var(--tlg-text);
    font-family: Inter, "Segoe UI", Arial, sans-serif;
    font-size: 14px;
    line-height: 1.6;
}
h1, h2, h3, h4 {
    color: var(--tlg-navy);
    line-height: 1.25;
    margin-top: 0;
}
h1 { font-size: clamp(25px, 3vw, 34px); font-weight: 800; letter-spacing: -.6px; }
h2 { font-size: 22px; font-weight: 750; }
h3 { font-size: 17px; font-weight: 700; }
p { color: var(--tlg-muted); }
a { color: var(--tlg-navy); text-decoration: none; }
a:hover { color: var(--tlg-orange-dark); }
.wrap, .page-wrap, .page-container, .content-wrapper, .dashboard-wrap {
    width: min(1240px, calc(100% - 40px));
    margin: 30px auto;
}
.container {
    width: min(1240px, calc(100% - 40px));
    max-width: 1240px;
    margin: 28px auto;
    padding: 28px;
    background: var(--tlg-white);
    border: 1px solid var(--tlg-border);
    border-radius: 16px;
    box-shadow: var(--tlg-shadow);
}
.head, .page-header, .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px;
    margin-bottom: 24px;
}
.head h1, .page-header h1 { margin-bottom: 7px; }
.head p, .page-header p { margin: 0; }
nav, .navbar, .topnav, .staff-nav, .navigation, .nav-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
}
nav a, .navbar a, .topnav a, .staff-nav a, .navigation a, .nav-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 9px 14px;
    border-radius: 8px;
    color: var(--tlg-navy);
    font-weight: 750;
    transition: background .18s ease, color .18s ease, transform .18s ease;
}
nav a:hover, .navbar a:hover, .topnav a:hover,
.staff-nav a:hover, .navigation a:hover, .nav-links a:hover {
    background: #fff0e5;
    color: var(--tlg-orange-dark);
    text-decoration: none;
}
.btn, button, input[type="submit"], input[type="button"], .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 42px;
    padding: 10px 17px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: var(--tlg-navy);
    color: #fff !important;
    font: inherit;
    font-weight: 750;
    line-height: 1.2;
    text-align: center;
    text-decoration: none !important;
    cursor: pointer;
    transition: background .18s ease, box-shadow .18s ease, transform .18s ease;
}
.btn:hover, button:hover, input[type="submit"]:hover,
input[type="button"]:hover, .button:hover {
    background: var(--tlg-navy-dark);
    color: #fff !important;
    box-shadow: 0 4px 12px rgba(11,31,58,.16);
    transform: translateY(-1px);
}
.btn.orange, .btn-primary, .btn-orange, .button-primary,
button.orange, input.orange {
    background: var(--tlg-orange);
    color: #fff !important;
}
.btn.orange:hover, .btn-primary:hover, .btn-orange:hover,
.button-primary:hover, button.orange:hover {
    background: var(--tlg-orange-dark);
}
.btn.navy, .btn-secondary, .btn-outline {
    background: var(--tlg-navy);
    color: #fff !important;
}
.btn-danger, .delete-btn { background: #b42318 !important; }
.btn-success, .success-btn { background: #18794e !important; }
.filters, .filter-form, .search-form {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0 0 22px;
    padding: 16px;
    background: #f8fafc;
    border: 1px solid var(--tlg-border);
    border-radius: var(--tlg-radius);
}
.filters input, .filters select, .filter-form input, .filter-form select,
.search-form input, .search-form select { flex: 1 1 190px; }
input:not([type="checkbox"]):not([type="radio"]):not([type="submit"]):not([type="button"]),
select, textarea {
    width: 100%;
    min-height: 43px;
    padding: 10px 12px;
    border: 1px solid #ccd5e1;
    border-radius: 8px;
    background: #fff;
    color: var(--tlg-text);
    font: inherit;
    outline: none;
    transition: border-color .18s ease, box-shadow .18s ease;
}
input:focus, select:focus, textarea:focus {
    border-color: var(--tlg-orange) !important;
    box-shadow: 0 0 0 3px rgba(244,123,32,.13);
}
textarea { min-height: 110px; resize: vertical; }
label { display: block; margin-bottom: 6px; color: var(--tlg-navy); font-weight: 700; }
form p { margin-bottom: 15px; }
.tablebox, .table-container, .table-responsive {
    width: 100%;
    overflow-x: auto;
    margin: 18px 0 0;
    border: 1px solid var(--tlg-border);
    border-radius: 12px;
    background: #fff;
}
table {
    width: 100%;
    min-width: 700px;
    border-collapse: separate;
    border-spacing: 0;
    background: #fff;
}
thead th {
    padding: 15px 16px;
    background: var(--tlg-navy);
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    text-align: left;
    text-transform: uppercase;
    letter-spacing: .45px;
    white-space: nowrap;
}
tbody td {
    padding: 15px 16px;
    border-bottom: 1px solid #e9edf3;
    vertical-align: middle;
    color: #38475b;
}
tbody tr:last-child td { border-bottom: 0; }
tbody tr:nth-child(even) { background: #f8fafc; }
tbody tr:hover { background: #fff5ed; }
td strong { color: var(--tlg-navy); }
td .btn { min-height: 36px; padding: 8px 12px; white-space: nowrap; }
.status, .badge, .status-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 5px 10px;
    border: 1px solid #f6d1b4;
    border-radius: 999px;
    background: #fff0e5;
    color: #99420a;
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
}
.card, .stat-card, .metric-card, .dashboard-card, .panel, .section-card {
    min-width: 0;
    padding: 21px;
    border: 1px solid var(--tlg-border);
    border-radius: var(--tlg-radius);
    background: #fff;
    box-shadow: 0 3px 12px rgba(11,31,58,.04);
}
.cards, .stats-grid, .dashboard-grid, .metrics-grid, .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 18px;
}
.card h2, .stat-card h2, .metric-card h2,
.dashboard-card h2 { margin-bottom: 8px; }
.empty, .empty-state {
    padding: 42px 22px;
    border: 1px dashed #cbd5e1;
    border-radius: 12px;
    background: #f8fafc;
    text-align: center;
}
hr { border: 0; border-top: 1px solid var(--tlg-border); margin: 24px 0; }
.alert, .message, .messages li {
    padding: 12px 15px;
    margin: 12px 0;
    border-radius: 8px;
    background: #fff0e5;
    color: #8a3b09;
}
footer {
    color: var(--tlg-muted);
    text-align: center;
}
@media (max-width: 700px) {
    .wrap, .page-wrap, .page-container, .content-wrapper, .dashboard-wrap,
    .container {
        width: calc(100% - 24px);
        margin: 12px auto;
    }
    .container { padding: 17px; border-radius: 12px; }
    .head, .page-header, .section-header {
        align-items: stretch;
        flex-direction: column;
        gap: 12px;
    }
    .head > a, .page-header > a { align-self: flex-start; }
    .filters, .filter-form, .search-form {
        align-items: stretch;
        flex-direction: column;
        padding: 12px;
    }
    .filters > *, .filter-form > *, .search-form > * { width: 100%; }
    nav, .navbar, .topnav, .staff-nav, .navigation, .nav-links { gap: 5px; }
    nav a, .navbar a, .topnav a, .staff-nav a, .navigation a, .nav-links a {
        padding: 8px 10px;
        font-size: 12px;
    }
    .cards, .stats-grid, .dashboard-grid, .metrics-grid, .card-grid {
        grid-template-columns: 1fr;
    }
}
</style>
</head>

<body>

<div class="topbar">
    THE LABEL GROUP â€¢ Staff Management System
</div>

<header class="header">

    <div class="header-inner">

        <a href="{% url 'staff_dashboard' %}">
            <img
                src="{% static 'logo 2 (1).png' %}"
                alt="THE LABEL GROUP"
                class="logo"
            >
        </a>

        <div class="header-title">
            <h1>Collection Calendar Orders</h1>
            <p>Manage customer Collection Calendar Sticker requests</p>
        </div>

    </div>

</header>

<main class="page">

    <a href="{% url 'staff_dashboard' %}" class="back-link">
        â† Back to Staff Dashboard
    </a>

    <div class="card">

        <div class="card-header">

            <h2>Customer Requests</h2>

            <div class="count">
                {{ calendar_orders|length }} Request{{ calendar_orders|length|pluralize }}
            </div>

        </div>

        <div class="filters">

            <form method="get">

                <input
                    type="text"
                    name="q"
                    value="{{ search_query }}"
                    placeholder="Search company, name, email or phone..."
                >

                <select name="status">

                    <option value="">
                        All Statuses
                    </option>

                    {% for value, label in status_choices %}

                        <option
                            value="{{ value }}"
                            {% if selected_status == value %}selected{% endif %}
                        >
                            {{ label }}
                        </option>

                    {% endfor %}

                </select>

                <button type="submit" class="filter-button">
                    Search
                </button>

                <a
                    href="{% url 'staff_calendar_order_list' %}"
                    class="clear-button"
                >
                    Clear
                </a>

            </form>

        </div>

        {% if calendar_orders %}

            <div class="table-wrapper">

                <table>

                    <thead>

                        <tr>
                            <th>Request</th>
                            <th>Company</th>
                            <th>Customer</th>
                            <th>Calendar Year</th>
                            <th>Quantity</th>
                            <th>Created</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        {% for order in calendar_orders %}

                            <tr>

                                <td>
                                    <a
                                        href="{% url 'staff_calendar_order_detail' order_id=order.id %}"
                                        class="order-link"
                                    >
                                        <span class="request-number">
                                            #{{ order.id }}
                                        </span>
                                    </a>
                                </td>

                                <td>
                                    <a
                                        href="{% url 'staff_calendar_order_detail' order_id=order.id %}"
                                        class="order-link"
                                    >
                                        <div class="company">
                                            {{ order.company }}
                                        </div>
                                    </a>
                                </td>

                                <td>
                                    <a
                                        href="{% url 'staff_calendar_order_detail' order_id=order.id %}"
                                        class="order-link"
                                    >
                                        <div class="customer">
                                            {{ order.name }}<br>
                                            {{ order.email }}<br>
                                            {{ order.phone }}
                                        </div>
                                    </a>
                                </td>

                                <td>
                                    <a
                                        href="{% url 'staff_calendar_order_detail' order_id=order.id %}"
                                        class="order-link"
                                    >
                                        {{ order.calendar_year }}
                                    </a>
                                </td>

                                <td>
                                    <a
                                        href="{% url 'staff_calendar_order_detail' order_id=order.id %}"
                                        class="order-link"
                                    >
                                        <span class="quantity">
                                            {{ order.quantity }}
                                        </span>
                                    </a>
                                </td>

                                <td>
                                    <a
                                        href="{% url 'staff_calendar_order_detail' order_id=order.id %}"
                                        class="order-link"
                                    >
                                        {{ order.created_at|date:"M d, Y" }}<br>
                                        {{ order.created_at|date:"g:i A" }}
                                    </a>
                                </td>

                                <td>

                                    <a
                                        href="{% url 'staff_calendar_order_detail' order_id=order.id %}"
                                        class="order-link"
                                    >

                                        <span class="status status-{{ order.status }}">
                                            {{ order.get_status_display }}
                                        </span>

                                    </a>

                                </td>

                                <td>

                                    <a
                                        href="{% url 'staff_calendar_order_detail' order_id=order.id %}"
                                        class="view-button"
                                    >
                                        View Request
                                    </a>

                                </td>

                            </tr>

                        {% endfor %}

                    </tbody>

                </table>

            </div>

        {% else %}

            <div class="empty">

                <h3>No Collection Calendar Requests</h3>

                <p>
                    There are currently no customer Collection Calendar Sticker requests.
                </p>

            </div>

        {% endif %}

    </div>

</main>

<footer class="footer">

    <img
        src="{% static 'logo 2 (1).png' %}"
        alt="THE LABEL GROUP"
    >

    <p>
        Professional Industrial Identification
    </p>

</footer>

</body>
</html>
